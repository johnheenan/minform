{
  "name": "Minform",
  "version": "0.4.1",
  "description": "Website Template Minimalist Forms",
  "private": true,
  "type": "module",
  "workspaces": [
    "do"
  ],
  "scripts": {
    "start": "ELTY_OPTIONS='--input=./site-1' npm -w do run start",
    "stage": "ELTY_OPTIONS='--input=./site-1' npm -w do run stage",
    "build": "ELTY_OPTIONS='--input=./site-1' npm -w do run build",
    "prestage": "curl https://raw.githubusercontent.com/anyblades/bladeswitch/refs/heads/main/admin/index.html -o ./_public/admin/index.html",
    "dlbaseblog": "curl -L https://github.com/11ty/eleventy-base-blog/tarball/main | tar -xz --strip-components=2 --wildcards -C ./site-1 '*/content/blog/*.md' '*/content/blog/*.png' && sed -i 's/\\.md//g' ./site-1/blog/secondpost.md && sed -i 's/blog\\/third/\\/blog\\/third/g' ./site-1/blog/secondpost.md"
  },
  "author": "John Heenan and others",
  "license": "MIT",
  "devDependencies": {
    "eleventy-auto-cache-buster": "^0.9.2",
    "prettier-plugin-jinja-template": "^2.1.0",
    "serve": "^14.2.5"
  },
  "dependencies": {
    "@11ty/eleventy": "4.0.0-alpha.7",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@anyblades/blades": "^2.2.0",
    "@anyblades/eleventy-blades": "^0.28.0-beta.4",
    "@anyblades/pico": "^2.2.1",
    "@tailwindcss/cli": "^4.2.1",
    "date-fns": "^4.1.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1"
  }
}
